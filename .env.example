# ── 필수 경로 설정 ────────────────────────────────────────
# 논문 PDF가 저장된 폴더 (절대 경로)
# Windows 예시: C:/Users/사용자명/Documents/논문
# WSL 예시:     /mnt/c/Users/사용자명/Documents/논문
# macOS 예시:   /Users/사용자명/Documents/논문
PDF_DIR=

# Obsidian 마크다운 노트 출력 폴더 (절대 경로)
MARKDOWN_DIR=

# Zotero storage 폴더 (절대 경로)
# Windows 기본: C:/Users/사용자명/Zotero/storage
ZOTERO_STORAGE=

# ── Gemini 인증 (둘 중 하나 선택) ───────────────────────────
# 방식 1 — API 키: https://aistudio.google.com/apikey 에서 발급 후 아래에 입력
GEMINI_API_KEY=
# 방식 2 — Gemini CLI 구독 크레딧:
#   @google/gemini-cli 가 설치·로그인된 상태이면 위 줄을 비워두거나 삭제하면 자동 전환됨
#   (GEMINI_API_KEY 값이 없을 때 gemini CLI를 자동으로 사용)

# Zotero Library ID (https://www.zotero.org/settings → Your user ID)
ZOTERO_LIBRARY_ID=

# Zotero API 키 (https://www.zotero.org/settings/keys)
ZOTERO_API_KEY=

# CrossRef Polite Pool 등록용 이메일 (본인 이메일 입력 — CrossRef 우선 처리 레인 적용)
CROSSREF_MAILTO=

# ── 선택 설정 (기본값 있음) ───────────────────────────────
# 스크립트 폴더 경로 (기본: config.py가 있는 폴더)
# SCRIPT_DIR=

# Gemini 모델명 (기본: gemini-3-flash-preview / gemini-2.5-flash-lite)
# GEMINI_MODEL=gemini-3-flash-preview
# GEMINI_MODEL_LITE=gemini-2.5-flash-lite

# Gemini 요청 타임아웃 초 (기본: 120)
# GEMINI_TIMEOUT=120

# Gemini 요청 간 딜레이 초 (기본: 4, 분당 15회 제한 방지)
# GEMINI_REQUEST_DELAY=4

# Zotero 폴링 간격 초 (기본: 60)
# ZOTERO_POLL_INTERVAL=60

# Zotero 역방향 동기화 (기본: true)
# ZOTERO_NOTE_SYNC=true
